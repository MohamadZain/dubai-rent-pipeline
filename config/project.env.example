# Copy to config/project.env on the VM and fill in. project.env is git-ignored.
# Names only -- no keys or passwords. Access uses `az login` (your Azure identity).

RESOURCE_GROUP=your-resource-group
LAKE=amazonlakeYOUR_ID            # ADLS Gen2 storage account from Lab 3
DATABRICKS_WORKSPACE=dsai3202-databricks
CATALOG=dsai3202_databricks
SCHEMA=s_YOUR_ID
VM_NAME=vm-titanic-lab2

# Project paths inside the lake (do not change between runs)
RAW_PREFIX=raw/dld_rents          # versioned: raw/dld_rents/v1/
PROCESSED_PREFIX=processed/dld_rents
CURATED_PREFIX=curated/dld_rents

KAGGLE_DATASET=zainabhejairi/dubai-real-estates-1969-2023
SOURCE_FILE=DLD_Rents.csv
